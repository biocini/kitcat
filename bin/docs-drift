#!/usr/bin/env bash
set -euo pipefail

# docs-drift — validate docs/ARCHITECTURE.md status table against
# the actual Cat.* modules on disk

arch="docs/ARCHITECTURE.md"
[ -f "$arch" ] || { echo "Error: $arch not found" >&2; exit 1; }

drift=0
warn() { echo "DRIFT: $1"; drift=1; }

# --- Parse the status table ---
# Use awk to extract Module and Status columns from table rows.
# Table format: | Module | Stratum | Status | Notes |
declare -A doc_status
declare -A doc_seen
while read -r module status; do
    [ -z "$module" ] && continue
    doc_status["$module"]="$status"
    doc_seen["$module"]=1
done < <(awk -F'|' '/^\| Cat\.[A-Za-z.]+ +\|/ {
    gsub(/^ +| +$/, "", $2); gsub(/^ +| +$/, "", $4);
    print $2, $4
}' "$arch")

# --- Discover modules on disk ---
declare -A disk_modules
while IFS= read -r file; do
    # Convert src/Cat/Foo/Bar.lagda.md → Cat.Foo.Bar
    mod="$(echo "$file" | sed 's|^src/||;s|\.lagda\.md$||' | tr '/' '.')"
    disk_modules["$mod"]="$file"
done < <(fd -e lagda.md . src/Cat/ | sort)

# --- Check: every disk module is in the table ---
for mod in "${!disk_modules[@]}"; do
    if [ -z "${doc_seen[$mod]:-}" ]; then
        warn "$mod exists on disk but is not in ARCHITECTURE.md"
    fi
done

# --- Check: every table module exists on disk ---
for mod in "${!doc_status[@]}"; do
    status="${doc_status[$mod]}"
    file="src/$(echo "$mod" | tr '.' '/').lagda.md"

    if [ "$status" = "archived" ]; then
        # Archived modules should be in Stash/, not src/
        stash="Stash/$(echo "$mod" | tr '.' '/').lagda.md"
        if [ ! -f "$stash" ] && [ ! -f "$file" ]; then
            warn "$mod marked archived but not found in Stash/ or src/"
        fi
        continue
    fi

    if [ ! -f "$file" ]; then
        warn "$mod listed in ARCHITECTURE.md but $file not found"
        continue
    fi

    # --- Check status accuracy ---
    # Detect {! !} holes (any spacing) as the mechanical signal for
    # incomplete code. Commented-out blocks are ambiguous (could be
    # alternatives) so they're left to human judgment.
    has_holes=false
    if grep -qE '\{!' "$file" 2>/dev/null; then
        has_holes=true
    fi

    case "$status" in
        complete)
            if $has_holes; then
                warn "$mod marked complete but has {!!} holes"
            fi
            ;;
        blocked)
            if ! $has_holes; then
                warn "$mod marked blocked but has no {!!} holes (resolved?)"
            fi
            ;;
        partial)
            # Partial modules may lack holes if the missing piece is
            # simply absent (e.g., Rezk retraction). Only warn, don't
            # flag as drift, since this requires human judgment.
            if ! $has_holes; then
                echo "NOTE: $mod marked partial with no {!!} holes — verify manually"
            fi
            ;;
        research)
            # Research modules should not be imported by non-research modules
            importers="$(grep -rl "import ${mod}" src/Cat/ 2>/dev/null | grep -v "$file" || true)"
            for imp in $importers; do
                imp_mod="$(echo "$imp" | sed 's|^src/||;s|\.lagda\.md$||' | tr '/' '.')"
                imp_status="${doc_status[$imp_mod]:-unknown}"
                if [ "$imp_status" != "research" ]; then
                    warn "$mod marked research but imported by $imp_mod ($imp_status)"
                fi
            done
            ;;
    esac
done

if [ "$drift" -eq 0 ]; then
    echo "docs/ARCHITECTURE.md is up to date."
else
    exit 1
fi
