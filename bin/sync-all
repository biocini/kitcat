#!/usr/bin/env bash
# sync-all — keep src/All.lagda.md in sync with the filesystem.
#
# All.lagda.md is the whole-library typecheck target. It must contain
# AGGREGATOR ROOTS ONLY: a module belongs in All iff no other managed
# module publicly re-exports it (via `open import ... public`). Such a
# module is reachable from All through its re-exporter, so a direct
# entry would be redundant.
#
# Usage:
#   sync-all                # report drift (missing / stale / redundant)
#   sync-all --fix          # insert missing roots, drop stale + redundant
#   sync-all --regenerate   # rewrite All from scratch (grouped, sorted)
#
# --fix inserts each missing root into its namespace cluster — the
# first contiguous block of imports sharing the module's top-level
# namespace — alphabetically; with no such cluster it opens a new
# one after the last import line. Existing lines are never moved.
#
# Test/* is unmanaged: never added automatically, existing entries kept.
set -euo pipefail

# rg exits 1 when nothing matches — an empty set for the extractions
# below, not an error. Any other nonzero status is a real failure and
# must propagate (stderr is untouched either way).
rg_allow_empty() { rg "$@" || [ $? -eq 1 ]; }

ALL="src/All.lagda.md"
fix=false
regen=false
for arg in "$@"; do
  case "$arg" in
    --fix) fix=true ;;
    --regenerate) regen=true ;;
    -h|--help)
      sed -n '2,/^$/s/^# \{0,1\}//p' "$0"; exit 0 ;;
    *) echo "sync-all: unknown argument '$arg'" >&2; exit 2 ;;
  esac
done

# ── managed modules: everything on disk except All, Stash, Test ───────
ALL_MODS="$(mktemp)"
trap 'rm -f "$ALL_MODS" "$REEXPORTED" "$ROOTS" "$ACTIVE" "$WIP"' EXIT
REEXPORTED="$(mktemp)"; ROOTS="$(mktemp)"; ACTIVE="$(mktemp)"; WIP="$(mktemp)"

fd -e lagda.md . src/ \
  | grep -v '^src/All\.lagda\.md$' \
  | grep -v '^src/Stash/' \
  | grep -v '^src/Test/' \
  | sed 's|^src/||; s|\.lagda\.md$||; s|/|.|g' \
  | sort -u > "$ALL_MODS"

# ── publicly re-exported targets, from managed modules only ──────────
# Matches `open import M ... public` regardless of leading indentation.
# Test modules are excluded: their re-exports do not help All reach
# anything, since Test is not part of the managed set.
rg_allow_empty --no-filename \
  --glob '!src/All.lagda.md' --glob '!src/Stash/**' --glob '!src/Test/**' \
  "^[[:space:]]*open import ([A-Z][A-Za-z0-9._'-]*) .*public" src/ \
  -or '$1' | sort -u > "$REEXPORTED"

# ── roots: managed modules that nothing re-exports ───────────────────
comm -23 "$ALL_MODS" "$REEXPORTED" > "$ROOTS"

# ── current state of All.lagda.md ────────────────────────────────────
# Active imports: lines like `import Foo.Bar` (All uses bare `import`).
rg_allow_empty "^import ([A-Z][A-Za-z0-9._'-]*)" "$ALL" -or '$1' --no-filename \
  | sort -u > "$ACTIVE"
# WIP: commented-out imports, preserved verbatim across --fix/--regenerate.
rg_allow_empty "^-- import ([A-Z][A-Za-z0-9._'-]*)" "$ALL" -or '$1' --no-filename \
  | sort -u > "$WIP"

# Roots the user has chosen to keep as Test entries are unmanaged:
# subtract current Test/* imports from "missing" so we never re-add them.
TEST_ENTRIES="$(mktemp)"; trap 'rm -f "$ALL_MODS" "$REEXPORTED" "$ROOTS" "$ACTIVE" "$WIP" "$TEST_ENTRIES"' EXIT
rg_allow_empty "^import (Test\.[A-Za-z0-9._'-]*)" "$ALL" -or '$1' --no-filename \
  | sort -u > "$TEST_ENTRIES"

missing_comm() { comm -23 "$ROOTS" "$ACTIVE" | comm -23 - "$WIP"; }
# stale: active import whose source file no longer exists. Checked by
# file presence (not set membership) so unmanaged Test/* entries are
# only flagged when genuinely gone.
stale_comm() {
  local f mod
  while IFS= read -r mod; do
    f="src/$(printf '%s' "$mod" | tr '.' '/').lagda.md"
    [ -f "$f" ] || printf '%s\n' "$mod"
  done < "$ACTIVE"
}
# redundant: active imports that some module re-exports (covered) AND
# are not roots themselves. Test/* and WIP are exempt.
redundant_comm() {
  comm -12 "$ACTIVE" "$REEXPORTED" \
    | comm -23 - "$TEST_ENTRIES" \
    | comm -23 - "$ROOTS"
}

# ── report ───────────────────────────────────────────────────────────
missing="$(missing_comm)"; stale="$(stale_comm)"; redundant="$(redundant_comm)"
issues=0
[ -n "$missing" ]  && { issues=1; printf '%s\n' "Missing from All (roots not imported):"; printf '  + %s\n' $missing; }
[ -n "$stale" ]    && { issues=1; printf '%s\n' "Stale in All (file not found):";          printf '  - %s\n' $stale; }
[ -n "$redundant" ]&& { issues=1; printf '%s\n' "Redundant in All (re-exported by another module):"; printf '  ~ %s\n' $redundant; }
[ -s "$WIP" ]      && { printf '%s\n' "WIP (commented out):"; printf '  # %s\n' $(cat "$WIP"); }
[ "$issues" -eq 0 ] && [ ! -s "$WIP" ] && echo "All.lagda.md is in sync."

# Report mode gates on drift: a drifted All is a failure a reviewer or
# CI catches, the drift analog of lint's nonzero exit. --fix / --regenerate
# resolve drift and so do not gate.
if ! $fix && ! $regen && [ "$issues" -ne 0 ]; then
  exit 1
fi

# ── regenerate: full clean rebuild, grouped by top-level namespace ───
if $regen; then
  # Preserve the prose header (everything up to and including the opening
  # ```agda fence) and the module/OPTIONS lines; replace the import body.
  # Collect manual Test/* entries to preserve.
  header_top=$(rg_allow_empty -n -m1 '^```agda\s*$' "$ALL" | cut -d: -f1)
  if [ -z "$header_top" ]; then
    echo "sync-all: no \`agda code fence found in $ALL" >&2; exit 1
  fi
  # Keep through the module line.
  mod_line=$(rg_allow_empty -n -m1 '^module All where' "$ALL" | cut -d: -f1)
  keep_upto=${mod_line:-$header_top}
  {
    sed -n "1,${keep_upto}p" "$ALL"
    echo ""
    # Group roots by top-level namespace, sorted within group.
    cat <(comm -23 "$ROOTS" "$WIP") "$TEST_ENTRIES" | sort -u \
      | awk -F. '{print $1"\t"$0}' \
      | sort -k1,1 -k2,2 \
      | awk -F'\t' 'NR>1 && $1!=prev{print ""} {print "import "$2; prev=$1}'
    [ -s "$WIP" ] && {
      echo ""
      rg_allow_empty '^-- import ' "$ALL" --no-filename
    }
    echo '```'
  } > "${ALL}.tmp" && mv "${ALL}.tmp" "$ALL"
  echo "Regenerated $ALL ($(wc -l < "$ALL" | tr -d ' ') lines)."
  exit 0
fi

# ── fix: surgical — drop stale/redundant, insert missing roots ───────
if $fix; then
  changed=0
  # Remove stale and redundant active imports.
  for mod in $stale $redundant; do
    esc=$(printf '%s' "$mod" | sed 's/\./\\./g')
    # delete only bare `import Mod` lines, never `-- import Mod` (WIP)
    if rg -q "^import ${esc}\$" "$ALL"; then
      rg -v "^import ${esc}\$" "$ALL" > "${ALL}.tmp" && mv "${ALL}.tmp" "$ALL"
      echo "Removed: import $mod"; changed=1
    fi
  done
  # Insert each missing root into its namespace cluster: the first
  # contiguous block of `import` lines sharing the module's
  # top-level namespace, kept alphabetical. Pass 1 names the
  # insertion point as "<line> <mode>" (insert before <line>):
  # `cluster` — inside the namespace cluster; `newcluster` — no
  # cluster exists, open one (blank-line separator) after the last
  # import line; `fence` — no imports at all, fall back to before
  # the closing fence. Existing lines (manual Test/* entries, WIP
  # comments, earlier strays) are never moved.
  for mod in $missing; do
    ns="${mod%%.*}"
    point=$(awk -v mod="$mod" -v ns="$ns" '
      BEGIN { new = "import " mod }
      {
        isns = (index($0, "import " ns ".") == 1 || $0 == "import " ns)
        if ($0 ~ /^import /) last_import = NR
        if (isns && !cluster_done) {
          in_cluster = 1; cluster_last = NR
          if (!found && $0 > new) found = NR
        } else if (in_cluster) { in_cluster = 0; cluster_done = 1 }
      }
      END {
        if (cluster_last) print (found ? found : cluster_last + 1) " cluster"
        else if (last_import) print last_import + 1 " newcluster"
        else print "0 fence"
      }' "$ALL")
    line="${point% *}"; mode="${point#* }"
    if [ "$mode" = "fence" ]; then
      awk -v mod="$mod" \
        '/^```$/ && !done { print "import " mod; done = 1 } { print }' \
        "$ALL" > "${ALL}.tmp" && mv "${ALL}.tmp" "$ALL"
    else
      text="import ${mod}"
      # awk -v expands the \n escape: newcluster carries its
      # blank-line separator inside the inserted text.
      if [ "$mode" = "newcluster" ]; then text="\n${text}"; fi
      awk -v n="$line" -v text="$text" '
        NR == n { printf "%s\n", text }
        { print }
        END { if (NR < n) printf "%s\n", text }
      ' "$ALL" > "${ALL}.tmp" && mv "${ALL}.tmp" "$ALL"
    fi
    echo "Added: import $mod"; changed=1
  done
  [ "$changed" -eq 0 ] && echo "Nothing to fix." || true
fi
