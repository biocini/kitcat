#!/usr/bin/env bash
set -euo pipefail

# lint — unified lint runner for kitcat
# Usage: lint [--check width|flags]

PROSE_WIDTH=72
CODE_WIDTH=85
checks=()
while [ $# -gt 0 ]; do
    case "$1" in
        --check) shift; checks+=("$1"); shift ;;
        -h|--help)
            echo "Usage: lint [--check width] [--check flags]"
            echo "No args = run all checks."
            exit 0 ;;
        *) checks+=("$1"); shift ;;
    esac
done

[ ${#checks[@]} -eq 0 ] && checks=(width flags)

issues=0

# ── width check ──────────────────────────────────────────────
check_width() {
    local file="$1"
    local in_code=false
    local lineno=0
    local limit

    while IFS= read -r line; do
        lineno=$((lineno + 1))

        # Toggle code blocks — closing fence is bare ```, opening
        # fence may have a language tag (```agda, ```bash, etc.)
        if [[ "$line" == '```' ]]; then
            in_code=false
            continue
        elif [[ "$line" == '```'* ]] && ! $in_code; then
            in_code=true
            continue
        fi

        if $in_code; then
            limit=$CODE_WIDTH
        else
            limit=$PROSE_WIDTH
        fi

        len=${#line}
        if [ "$len" -gt "$limit" ]; then
            echo "  ${file}:${lineno}: ${len} chars (limit ${limit})"
            issues=$((issues + 1))
        fi
    done < "$file"
}

run_width() {
    echo "── width ──"
    while IFS= read -r f; do
        check_width "$f"
    done < <(fd -e lagda.md . src/ | grep -v Stash/ | sort)
}

# ── flags check ──────────────────────────────────────────────
run_flags() {
    echo "── flags ──"
    while IFS= read -r f; do
        # Extract the OPTIONS pragma
        opts="$(rg 'OPTIONS' "$f" -o --no-filename 2>/dev/null | head -1 || true)"
        if [ -z "$opts" ]; then
            echo "  ${f}: no OPTIONS pragma found"
            issues=$((issues + 1))
            continue
        fi

        pragma="$(rg '\{-# OPTIONS .* #-\}' "$f" -o --no-filename 2>/dev/null | head -1 || true)"
        if [ -z "$pragma" ]; then
            echo "  ${f}: OPTIONS found but pragma malformed"
            issues=$((issues + 1))
            continue
        fi

        # Check for --safe
        if ! echo "$pragma" | grep -q -- '--safe'; then
            echo "  ${f}: missing --safe"
            issues=$((issues + 1))
        fi

        # Check for cubical flag
        if ! echo "$pragma" | grep -qE -- '--(cubical|erased-cubical|cubical-compatible)'; then
            echo "  ${f}: missing cubical flag"
            issues=$((issues + 1))
        fi

        # Check for --no-guardedness
        if ! echo "$pragma" | grep -q -- '--no-guardedness'; then
            echo "  ${f}: missing --no-guardedness"
            issues=$((issues + 1))
        fi
    done < <(fd -e lagda.md . src/ | grep -v Stash/ | sort)
}

# Run requested checks
for check in "${checks[@]}"; do
    case "$check" in
        width) run_width ;;
        flags) run_flags ;;
        *) echo "Unknown check: $check" >&2; exit 1 ;;
    esac
done

if [ "$issues" -gt 0 ]; then
    echo ""
    echo "$issues issue(s) found."
    exit 1
else
    echo ""
    echo "All checks passed."
fi
