#!/usr/bin/env bash
set -euo pipefail

# lint — unified lint runner for kitcat
# Usage: lint [--check width|flags]

# rg exits 1 when nothing matches — an empty set here, not an error.
# Any other nonzero status is a real failure and must propagate
# (stderr is untouched either way).
rg_allow_empty() { rg "$@" || [ $? -eq 1 ]; }

# grep -v exits 1 when it selects no lines (every line was filtered
# out) — an empty set, not an error; exit 2 is a real failure and
# must propagate. Same discipline as rg_allow_empty above.
grep_v_allow_empty() { grep -v "$@" || [ $? -eq 1 ]; }

cd "$(git rev-parse --show-toplevel)"

PROSE_WIDTH=72
CODE_WIDTH=85
checks=()
changed_mode=false
while [ $# -gt 0 ]; do
    case "$1" in
        --check) shift; checks+=("$1"); shift ;;
        --changed|changed) changed_mode=true; shift ;;
        -h|--help)
            echo "Usage: lint [width] [flags] [authoring] [changed]"
            echo "  No args      run width + flags over the whole src/ tree."
            echo "  changed      non-regression gate: only files modified vs"
            echo "               HEAD, and width only on added/modified lines"
            echo "               (the whole tree carries a known width baseline"
            echo "               while the library is in flight — full 'lint'"
            echo "               is the periodic strictification target)."
            exit 0 ;;
        *) checks+=("$1"); shift ;;
    esac
done

[ ${#checks[@]} -eq 0 ] && checks=(width flags)

# The lintable set, resolved once: an enumeration failure aborts here
# and an empty set is an error — the gate must never pass by having
# checked nothing. src/Test/ is tracked scratch and gate-exempt
# (Gloss.* is the polished tier); it is excluded by name, not by
# ignore-file side effect.
files="$(fd -e lagda.md --exclude Test . src/ | sort)"
if [ -z "$files" ]; then
    echo "lint: no .lagda.md files found under src/" >&2
    exit 1
fi

# Changed mode: the non-regression gate. Restrict the set to src/
# .lagda.md files modified vs HEAD (tracked edits + untracked new
# files), and record which line numbers are added/modified so the
# width check reports only those — a change is clean when it adds no
# over-width line, regardless of the tree's known baseline. An empty
# changed set is a clean pass here, not the enumeration error above.
declare -A ADDED_LINES=()
if $changed_mode; then
    changed_files="$(
        { git diff --name-only --diff-filter=d HEAD -- 'src/*.lagda.md' 'src/**/*.lagda.md'
          git ls-files --others --exclude-standard -- 'src/*.lagda.md' 'src/**/*.lagda.md'
        } | sort -u | rg_allow_empty -v '^src/Test/')"
    if [ -z "$changed_files" ]; then
        echo "lint: no changed .lagda.md files under src/ — clean."
        exit 0
    fi
    while IFS= read -r f; do
        [ -f "$f" ] || continue
        if git ls-files --error-unmatch "$f" >/dev/null 2>&1; then
            # Tracked: added/modified new-side line numbers from the
            # zero-context diff hunk headers (@@ -a,b +c,d @@).
            while IFS= read -r hh; do
                plus="${hh#*+}"; plus="${plus%% *}"
                start="${plus%%,*}"; count="${plus#*,}"
                [ "$count" = "$plus" ] && count=1
                i=0
                while [ "$i" -lt "$count" ]; do
                    ADDED_LINES["$f"$'\t'"$((start + i))"]=1
                    i=$((i + 1))
                done
            done < <(git diff --unified=0 HEAD -- "$f" | grep '^@@')
        else
            # Untracked new file: every line is added.
            n="$(wc -l < "$f")"
            i=1
            while [ "$i" -le "$n" ]; do
                ADDED_LINES["$f"$'\t'"$i"]=1
                i=$((i + 1))
            done
        fi
    done <<< "$changed_files"
    files="$changed_files"
fi

issues=0

# ── width check ──────────────────────────────────────────────
check_width() {
    local file="$1"
    local in_code=false
    local lineno=0
    local limit

    while IFS= read -r line; do
        lineno=$((lineno + 1))

        # Toggle code blocks — closing fence is bare ```, opening
        # fence may have a language tag (```agda, ```bash, etc.)
        if [[ "$line" == '```' ]]; then
            in_code=false
            continue
        elif [[ "$line" == '```'* ]] && ! $in_code; then
            in_code=true
            continue
        fi

        if $in_code; then
            limit=$CODE_WIDTH
        else
            limit=$PROSE_WIDTH
        fi

        len=${#line}
        if [ "$len" -gt "$limit" ]; then
            # Changed mode reports only lines the change itself adds or
            # modifies, so a pre-existing baseline violation in a touched
            # file does not block the commit.
            if $changed_mode && [ -z "${ADDED_LINES["$file"$'\t'"$lineno"]:-}" ]; then
                continue
            fi
            echo "  ${file}:${lineno}: ${len} chars (limit ${limit})"
            issues=$((issues + 1))
        fi
    done < "$file"
}

run_width() {
    echo "── width ──"
    while IFS= read -r f; do
        check_width "$f"
    done <<< "$files"
}

# ── flags check ──────────────────────────────────────────────
run_flags() {
    echo "── flags ──"
    while IFS= read -r f; do
        # Extract the OPTIONS pragma
        opts="$(rg_allow_empty -m1 -o --no-filename 'OPTIONS' "$f")"
        if [ -z "$opts" ]; then
            echo "  ${f}: no OPTIONS pragma found"
            issues=$((issues + 1))
            continue
        fi

        pragma="$(rg_allow_empty -m1 -o --no-filename '\{-# OPTIONS .* #-\}' "$f")"
        if [ -z "$pragma" ]; then
            echo "  ${f}: OPTIONS found but pragma malformed"
            issues=$((issues + 1))
            continue
        fi

        # Check for --safe
        if ! echo "$pragma" | grep -q -- '--safe'; then
            echo "  ${f}: missing --safe"
            issues=$((issues + 1))
        fi

        # Check for cubical flag
        if ! echo "$pragma" | grep -qE -- '--(cubical|erased-cubical|cubical-compatible)'; then
            echo "  ${f}: missing cubical flag"
            issues=$((issues + 1))
        fi

        # Check for --no-guardedness
        if ! echo "$pragma" | grep -q -- '--no-guardedness'; then
            echo "  ${f}: missing --no-guardedness"
            issues=$((issues + 1))
        fi
    done <<< "$files"
}

# ── authoring check (the skills tree's own rules) ────────────
# Opt-in (`lint authoring`): surfaces candidates a human confirms.
# Topology (see .agents/CLAUDE.md): a workflow is two masters — a
# small shim `.agents/skills/kitcat/<name>/SKILL.md` and a prompt body
# `.agents/prompts/<name>.md` — reached by two dir-level symlinks
# (.claude/commands → .agents/prompts, .claude/skills →
# .agents/skills/kitcat); pi reads the masters directly. Checks:
# shim name≠dir or no description, an unpaired shim or prompt, a
# harness tool name or a $-token other than $ARGUMENTS in a prompt
# body, a broken harness symlink, and an artifact path pattern
# drifting from its bind-once home form.
run_authoring() {
    echo "── authoring ──"
    # Distinctive tool identifiers only — never English words like Read
    # or Edit, which appear legitimately in prose.
    # PCRE (-P): the subagent lookahead excludes the capability noun
    # "subagent-dispatch".
    local tools='WebSearch|WebFetch|AskUserQuestion|NotebookEdit|web_search|fetch_content|web_fetch|batch_web_fetch|ask_user_question|subagent(?!-dispatch)|perplexity_search|ffgrep|fffind|get_subagent_result|steer_subagent|session_search|preview_export|memory_remember|run_in_background'
    local dir name skill prompt fmname hits dollars link target

    # Skill shims: name equals dir, has a description, and pairs with a prompt.
    for dir in .agents/skills/kitcat/*/; do
        name="$(basename "$dir")"
        skill="${dir}SKILL.md"
        [ -f "$skill" ] || { echo "  ${dir}: no SKILL.md shim"; issues=$((issues + 1)); continue; }
        fmname="$(rg_allow_empty -m1 -N '^name:[[:space:]]*(.+)' -or '$1' "$skill")"
        if [ "$fmname" != "$name" ]; then
            echo "  ${skill}: frontmatter name '$fmname' != dir '$name'"; issues=$((issues + 1))
        fi
        if ! rg -q '^description:' "$skill"; then
            echo "  ${skill}: missing 'description:' frontmatter"; issues=$((issues + 1))
        fi
        if [ ! -f ".agents/prompts/${name}.md" ]; then
            echo "  ${skill}: no master prompt .agents/prompts/${name}.md"; issues=$((issues + 1))
        fi
    done

    # Prompt bodies: no harness tool names, no $-token but $ARGUMENTS, paired with a shim.
    for prompt in .agents/prompts/*.md; do
        [ -f "$prompt" ] || continue
        name="$(basename "$prompt" .md)"
        if [ ! -d ".agents/skills/kitcat/${name}" ]; then
            echo "  ${prompt}: no matching skill shim .agents/skills/kitcat/${name}/"; issues=$((issues + 1))
        fi
        hits="$(rg_allow_empty -P -o -N "$tools" "$prompt" | sort -u | tr '\n' ' ')"
        if [ -n "$hits" ]; then
            echo "  ${prompt}: harness tool name in body (candidate): ${hits}"; issues=$((issues + 1))
        fi
        dollars="$(rg_allow_empty -o -N '\$\{?[A-Za-z0-9_@]+' "$prompt" | grep_v_allow_empty '^\$ARGUMENTS$' | sort -u | tr '\n' ' ')"
        if [ -n "$dollars" ]; then
            echo "  ${prompt}: \$-token other than \$ARGUMENTS (candidate): ${dollars}"; issues=$((issues + 1))
        fi
        # Shedding-rule drift canary: the [unvetted] conditions are
        # stated once in the contract; a prompt restating them has
        # drifted before and will again. Any of these phrases in a
        # prompt body is a restatement, not a deferral.
        if rg -qi 'until a human|until it is vetted|Lane ratifies before|rests on a PROVISIONAL' "$prompt"; then
            echo "  ${prompt}: shedding-rule restatement (defer to the contract lexicon)"; issues=$((issues + 1))
        fi
    done

    # Harness bridges: the two dir-level symlinks resolve to the masters.
    for pair in ".claude/commands:.agents/prompts" ".claude/skills:.agents/skills/kitcat"; do
        link="${pair%%:*}"; target="${pair##*:}"
        if [ ! -L "$link" ]; then
            echo "  ${link}: not a symlink (expected → ${target})"; issues=$((issues + 1))
        elif [ ! -d "$link" ]; then
            echo "  ${link}: symlink does not resolve to a directory"; issues=$((issues + 1))
        fi
    done

    # Path-pattern drift canary: artifact path patterns are stated
    # once at the bind-once home ("Slugs and file naming" in
    # .agents/CLAUDE.md) and restated across the layer. Each row is
    # "label<TAB>anchor-regex"; the anchor's capture group extracts
    # the canonical pattern from the home, so a home edit re-gates
    # every restatement with no row edit here. An occurrence is the
    # pattern's directory prefix followed by '<' — a directory-only
    # reference names the location, not the pattern, and is exempt —
    # and must begin with the canonical stem (the pattern minus its
    # .md extension), so suffixed run variants (-T1.md,
    # .provenance.md) pass by prefix while a stale shape fails. The
    # prefix is spliced into the occurrence regex verbatim; keep
    # future rows' patterns free of regex metacharacters. An anchor
    # that extracts no '<'-bearing .md pattern fails loudly — the
    # canary never passes vacuously.
    local home=".agents/CLAUDE.md"
    local pattern_rows=(
        $'plan\t^- Plan: `([^`]+)`'
        $'research\t^- Final: `([^`]+)`'
    )
    local layer_files=() pf row label anchor canonical stem occ_re lineno occ
    shopt -s globstar
    for pf in .agents/prompts/*.md .agents/skills/kitcat/**/*.md \
              .agents/*.md CLAUDE.md; do
        [ -f "$pf" ] || continue
        layer_files+=("$pf")
    done
    shopt -u globstar
    for row in "${pattern_rows[@]}"; do
        label="${row%%$'\t'*}"; anchor="${row#*$'\t'}"
        canonical="$(rg_allow_empty -m1 -N "$anchor" -or '$1' "$home")"
        case "$canonical" in
            *'<'*.md) ;;
            *) canonical="" ;;
        esac
        if [ -z "$canonical" ]; then
            echo "  cannot locate canonical ${label} pattern in ${home}"
            issues=$((issues + 1))
            continue
        fi
        stem="${canonical%.md}"
        occ_re="${canonical%%<*}<"'[^`[:space:]]*'
        for pf in "${layer_files[@]}"; do
            while IFS=: read -r lineno occ; do
                [ -n "$lineno" ] || continue
                case "$occ" in
                    "$stem"*) ;;
                    *)
                        echo "  ${pf}:${lineno}: '${occ}' drifts from canonical '${canonical}'"
                        issues=$((issues + 1)) ;;
                esac
            done <<< "$(rg_allow_empty -o -n --no-filename "$occ_re" "$pf")"
        done
    done
}

# Run requested checks
for check in "${checks[@]}"; do
    case "$check" in
        width) run_width ;;
        flags) run_flags ;;
        authoring) run_authoring ;;
        *) echo "Unknown check: $check" >&2; exit 1 ;;
    esac
done

if [ "$issues" -gt 0 ]; then
    echo ""
    echo "$issues issue(s) found."
    exit 1
else
    echo ""
    echo "All checks passed."
fi
