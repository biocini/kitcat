#!/usr/bin/env bash
set -euo pipefail

# lint — unified lint runner for kitcat
# Usage: lint [--check width|flags|imports]

PROSE_WIDTH=72
CODE_WIDTH=85
EXPECTED_FLAGS="--safe --erased-cubical --no-guardedness"

checks=()
while [ $# -gt 0 ]; do
    case "$1" in
        --check) shift; checks+=("$1"); shift ;;
        -h|--help)
            echo "Usage: lint [--check width] [--check flags] [--check imports]"
            echo "No args = run all checks."
            exit 0 ;;
        *) checks+=("$1"); shift ;;
    esac
done

[ ${#checks[@]} -eq 0 ] && checks=(width flags imports)

issues=0

# ── width check ──────────────────────────────────────────────
check_width() {
    local file="$1"
    local in_code=false
    local lineno=0
    local limit

    while IFS= read -r line; do
        lineno=$((lineno + 1))

        # Toggle code blocks
        if [[ "$line" == '```'* ]]; then
            if $in_code; then
                in_code=false
            else
                in_code=true
            fi
            continue
        fi

        if $in_code; then
            limit=$CODE_WIDTH
        else
            limit=$PROSE_WIDTH
        fi

        len=${#line}
        if [ "$len" -gt "$limit" ]; then
            echo "  ${file}:${lineno}: ${len} chars (limit ${limit})"
            issues=$((issues + 1))
        fi
    done < "$file"
}

run_width() {
    echo "── width ──"
    while IFS= read -r f; do
        check_width "$f"
    done < <(fd -e lagda.md . src/ | grep -v Stash/ | sort)
}

# ── flags check ──────────────────────────────────────────────
run_flags() {
    echo "── flags ──"
    while IFS= read -r f; do
        # Extract the OPTIONS pragma
        opts="$(rg 'OPTIONS' "$f" -o --no-filename 2>/dev/null | head -1)"
        if [ -z "$opts" ]; then
            echo "  ${f}: no OPTIONS pragma found"
            issues=$((issues + 1))
            continue
        fi

        pragma="$(rg '\{-# OPTIONS .* #-\}' "$f" -o --no-filename 2>/dev/null | head -1)"
        if [ -z "$pragma" ]; then
            echo "  ${f}: OPTIONS found but pragma malformed"
            issues=$((issues + 1))
            continue
        fi

        # Check for --safe
        if ! echo "$pragma" | grep -q -- '--safe'; then
            echo "  ${f}: missing --safe"
            issues=$((issues + 1))
        fi

        # Check for cubical flag
        if ! echo "$pragma" | grep -qE -- '--(cubical|erased-cubical|cubical-compatible)'; then
            echo "  ${f}: missing cubical flag"
            issues=$((issues + 1))
        fi

        # Check for --no-guardedness
        if ! echo "$pragma" | grep -q -- '--no-guardedness'; then
            echo "  ${f}: missing --no-guardedness"
            issues=$((issues + 1))
        fi
    done < <(fd -e lagda.md . src/ | grep -v Stash/ | sort)
}

# ── imports check ────────────────────────────────────────────
run_imports() {
    echo "── imports ──"
    while IFS= read -r f; do
        # For each "import Foo.Bar" or "open import Foo.Bar", check if
        # Foo.Bar is an aggregator directory AND the file only uses
        # definitions from a single submodule.
        while IFS= read -r imp; do
            imp_dir="src/$(echo "$imp" | tr '.' '/')"
            if [ -d "$imp_dir" ]; then
                # This import is an aggregator — check how many submodules
                # actually provide symbols used by this file. Heuristic:
                # count how many submodule names appear in the file.
                sub_count=0
                sub_match=""
                while IFS= read -r sub; do
                    sub_mod="$(echo "$sub" | sed 's|^src/||;s|\.lagda\.md$||' | tr '/' '.')"
                    sub_base="$(basename "$sub" .lagda.md)"
                    # Quick heuristic: does the file reference this submodule specifically?
                    if rg -q "\\b${sub_base}\\b" "$f" 2>/dev/null; then
                        sub_count=$((sub_count + 1))
                        sub_match="$sub_mod"
                    fi
                done < <(fd -e lagda.md --max-depth 1 . "$imp_dir" 2>/dev/null | sort)

                if [ "$sub_count" -eq 1 ] && [ -n "$sub_match" ]; then
                    echo "  ${f}: import ${imp} could narrow to ${sub_match}"
                    issues=$((issues + 1))
                fi
            fi
        done < <(rg '^\s*(open )?import ([A-Z][A-Za-z0-9.]*)\b' "$f" -or '$2' --no-filename 2>/dev/null | sort -u)
    done < <(fd -e lagda.md . src/ | grep -v Stash/ | sort)
}

# Run requested checks
for check in "${checks[@]}"; do
    case "$check" in
        width) run_width ;;
        flags) run_flags ;;
        imports) run_imports ;;
        *) echo "Unknown check: $check" >&2; exit 1 ;;
    esac
done

if [ "$issues" -gt 0 ]; then
    echo ""
    echo "$issues issue(s) found."
    exit 1
else
    echo ""
    echo "All checks passed."
fi
