#!/usr/bin/env bash
set -euo pipefail

# mmv — move/rename Agda modules with automatic refactoring

# rg exits 1 when nothing matches — an empty set here, not an error.
# Any other nonzero status is a real failure and must propagate
# (stderr is untouched either way).
rg_allow_empty() { rg "$@" || [ $? -eq 1 ]; }

usage() {
    echo "Usage: mmv OLD_MODULE NEW_MODULE [--dry-run]"
    echo ""
    echo "Move an Agda module and update all references."
    echo "Module names are dot-separated (e.g. Core.Base)."
    echo ""
    echo "  --dry-run  Show each would-be change (file:line: old → new)"
    echo "             without modifying anything"
    exit 1
}

[ $# -lt 2 ] && usage

old_module="$1"
new_module="$2"
dry_run=false
if [ $# -ge 3 ]; then
    if [ $# -gt 3 ] || [ "$3" != "--dry-run" ]; then
        echo "Error: unrecognized argument(s): ${*:3}" >&2
        usage
    fi
    dry_run=true
fi

git_root="$(git rev-parse --show-toplevel)"

old_path="src/$(echo "$old_module" | tr '.' '/').lagda.md"
new_path="src/$(echo "$new_module" | tr '.' '/').lagda.md"

old_file="${git_root}/${old_path}"
new_file="${git_root}/${new_path}"

if [ ! -f "$old_file" ]; then
    echo "Error: $old_path not found" >&2
    exit 1
fi

if [ -f "$new_file" ]; then
    echo "Error: $new_path already exists" >&2
    exit 1
fi

# Match the old name only when the next character is not an Agda
# name character (letter, digit, ', -), so renaming Core.Trait.Alt
# never touches Core.Trait.Alternative. A following `.` still
# matches: qualified references (Core.Trait.Alt.law) get renamed.
# Left boundary: a preceding name character or `.` excludes the
# match, so renaming Trait.Alt never touches Core.Trait.Alt.
old_re="$(echo "$old_module" | sed 's/\./\\./g')"
boundary_re="(^|[^A-Za-z0-9'.-])${old_re}(\$|[^A-Za-z0-9'-])"

# Find files that reference the old module name. The sweep runs in a
# command substitution, not a process substitution, so a real rg
# failure aborts here instead of silently yielding an empty sweep.
sweep="$(rg_allow_empty -l -e "$boundary_re" "${git_root}/src/" --glob '*.lagda.md' --glob '*.agda')"
affected_files=()
if [ -n "$sweep" ]; then
    while IFS= read -r f; do
        affected_files+=("$f")
    done <<< "$sweep"
fi

updated=${#affected_files[@]}

if $dry_run; then
    echo "Would move: $old_path → $new_path"
    echo "Would update $updated file(s):"
    for f in "${affected_files[@]}"; do
        OLD="$old_module" NEW="$new_module" REL="${f#"${git_root}/"}" perl -ne '
            if (/(?<![A-Za-z0-9\x27.-])\Q$ENV{OLD}\E(?![A-Za-z0-9\x27-])/) {
                my $orig = $_; chomp $orig;
                (my $new = $orig) =~ s/(?<![A-Za-z0-9\x27.-])\Q$ENV{OLD}\E(?![A-Za-z0-9\x27-])/$ENV{NEW}/g;
                print "  $ENV{REL}:$.: $orig → $new\n";
            }' "$f"
    done
    exit 0
fi

# Create target directory
new_dir="$(dirname "$new_file")"
mkdir -p "$new_dir"

# Move file (git mv if tracked)
if git ls-files --error-unmatch "$old_file" >/dev/null 2>&1; then
    git mv "$old_file" "$new_file"
else
    mv "$old_file" "$new_file"
fi

# Update references in all affected files (including the moved file itself)
all_files=("${affected_files[@]}")
# Also check the new file location
if ! printf '%s\n' "${all_files[@]}" | grep -qF "$old_file"; then
    all_files+=("$new_file")
fi

count=0
for f in "${all_files[@]}"; do
    # Adjust path if file was the one we moved
    target="$f"
    [ "$f" = "$old_file" ] && target="$new_file"
    [ -f "$target" ] || continue

    match=0
    rg -q -e "$boundary_re" "$target" || match=$?
    if [ "$match" -ge 2 ]; then
        echo "Error: rg failed on $target (exit $match)" >&2
        exit "$match"
    fi
    if [ "$match" -eq 0 ]; then
        OLD="$old_module" NEW="$new_module" \
            perl -i -pe 's/(?<![A-Za-z0-9\x27.-])\Q$ENV{OLD}\E(?![A-Za-z0-9\x27-])/$ENV{NEW}/g' "$target"
        count=$((count + 1))
    fi
done

echo "Moved: $old_path → $new_path"
echo "Updated $count file(s)"

# A moved module references itself in its `module … where` header, so
# a zero-update move means the sweep or the replacement failed — the
# file move has already happened; inspect before retrying.
if [ "$count" -eq 0 ]; then
    echo "Error: no references were updated, not even the moved module's own header" >&2
    exit 1
fi
