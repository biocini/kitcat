*.agdai
MAlonzo/**
_build/
__pycache__/
.DS_Store
*.bak
/Stash/
.attic/
.pi/tasks
.pi/hindsight

# notes/plans and notes/research are local working memory (run ledgers,
# research intermediates); the durable session bridge that IS tracked is
# notes/session-logs/ + CHANGELOG.md.
/notes/plans/
/notes/research/

# resources/: vendored source documents and derived forms are local-only;
# only the entry README (citation, hash, line-anchored map) is tracked.
resources/**/*.pdf
resources/**/*.ps
resources/**/*.djvu
resources/**/*.gz
resources/**/*.tar
resources/**/*.pdftext
resources/**/*.tex
resources/**/*.sty
resources/**/*.cls
resources/**/*.bib
resources/**/*.bbl
resources/**/*.json
resources/**/*.ind
resources/**/*.aux
resources/**/*.toc
resources/**/*.out
resources/**/*.log
resources/**/*.idx
